# Copy to .env on the Pi. Never commit the real .env.

# Where alpha1's ingest route lives. Reach it over your LAN/Tailscale, not the
# public internet -- this is a write endpoint, keep it off the open x402 surface.
EDGE_INGEST_URL=http://umbrel-box.local:4021/internal/edge/ingest

# Must match EDGE_INTERNAL_KEY set on the alpha1 side (docker-compose.yml / Portainer).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EDGE_INTERNAL_KEY=REPLACE_ME
